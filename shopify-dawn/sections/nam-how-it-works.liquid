{% comment %}
  Nuts About Mutts — "Booking is simple" steps (for the Dawn theme)
  Gives customers a clear direction: pick size → choose service → book.
{% endcomment %}

<style>
  #nam-how-{{ section.id }} { --nam-coral: {{ section.settings.accent_color }}; --nam-cream: #fdf9f3; --nam-ink: #2b2620; --nam-ink-soft: #6f675d; --nam-line: #e7dfd2; padding: 56px 20px; background: #fff; text-align: center; color: var(--nam-ink); }
  #nam-how-{{ section.id }} .nam-inner { max-width: 1120px; margin: 0 auto; }
  #nam-how-{{ section.id }} .nam-eyebrow { display: block; font-size: 13px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--nam-coral); margin-bottom: 8px; }
  #nam-how-{{ section.id }} h2 { font-size: clamp(28px, 4vw, 40px); margin: 0 0 32px; line-height: 1.15; }
  #nam-how-{{ section.id }} .nam-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
  #nam-how-{{ section.id }} .nam-card { background: var(--nam-cream); border: 1px solid var(--nam-line); border-radius: 20px; padding: 32px 24px; }
  #nam-how-{{ section.id }} .nam-icon { font-size: 42px; margin-bottom: 10px; }
  #nam-how-{{ section.id }} h3 { font-size: 19px; margin: 0 0 8px; }
  #nam-how-{{ section.id }} p { color: var(--nam-ink-soft); margin: 0; font-size: 15px; }
  #nam-how-{{ section.id }} .nam-cta { margin-top: 32px; }
  #nam-how-{{ section.id }} .nam-cta a { background: var(--nam-coral); color: #fff; border-radius: 999px; padding: 15px 32px; font-size: 16px; font-weight: 700; text-decoration: none; display: inline-block; box-shadow: 0 6px 20px rgba(244,132,95,.4); }
</style>

<div id="nam-how-{{ section.id }}">
  <div class="nam-inner">
    {% if section.settings.eyebrow != blank %}<span class="nam-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <div class="nam-grid">
      {% for block in section.blocks %}
        <div class="nam-card" {{ block.shopify_attributes }}>
          <div class="nam-icon">{{ block.settings.icon }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="nam-cta"><a href="{{ section.settings.button_link }}">🐾 {{ section.settings.button_label }}</a></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "NAM Booking Steps",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Easy as fetch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Booking is simple" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book an Appointment" },
    { "type": "url", "id": "button_link", "label": "Button link (your booking page)" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#F4845F" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "📏" },
        { "type": "text", "id": "title", "label": "Title", "default": "1. Pick your pup's size" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Small, medium, large, or extra large — pricing is clear for every size." }
      ]
    }
  ],
  "presets": [
    {
      "name": "NAM Booking Steps",
      "blocks": [
        { "type": "step", "settings": { "icon": "📏", "title": "1. Pick your pup's size", "text": "Small, medium, large, or extra large — pricing is clear for every size." } },
        { "type": "step", "settings": { "icon": "✂️", "title": "2. Choose a service", "text": "Full body cut, trim-up, bath only, or a puppy trim. Add extras if you like." } },
        { "type": "step", "settings": { "icon": "📅", "title": "3. Book your spot", "text": "Tell us when works and we'll confirm. You'll get text updates during the groom!" } }
      ]
    }
  ]
}
{% endschema %}
