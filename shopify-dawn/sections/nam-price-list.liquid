  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Services & Pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a size, see every price" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "No surprises at pickup — select your dog's size and prices update instantly." },
