{% comment %}
  We're Nuts About Mutts Inc — Follow Us (for the Dawn theme)
  A "follow our glow-ups" strip with big social buttons. Paste your
  Facebook / Instagram / TikTok links in the theme editor; buttons
  only show for the links you fill in.
{% endcomment %}

<style>
  #nam-social-{{ section.id }} { padding: 44px 20px; background: {{ section.settings.background_color }}; text-align: center; }
  #nam-social-{{ section.id }} .nam-inner { max-width: 780px; margin: 0 auto; }
  #nam-social-{{ section.id }} h2 { font-size: clamp(24px, 3.5vw, 32px); margin: 0 0 6px; color: #2b2620; line-height: 1.2; }
  #nam-social-{{ section.id }} p { color: #6f675d; margin: 0 0 22px; font-size: 15px; }
  #nam-social-{{ section.id }} .nam-buttons { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  #nam-social-{{ section.id }} .nam-social-btn { display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; padding: 13px 26px; font-size: 15px; font-weight: 700; text-decoration: none; color: #fff; transition: transform .15s, filter .15s; }
  #nam-social-{{ section.id }} .nam-social-btn:hover { transform: translateY(-2px); filter: brightness(1.05); }
  #nam-social-{{ section.id }} .nam-social-btn svg { width: 20px; height: 20px; fill: currentColor; }
  #nam-social-{{ section.id }} .nam-fb { background: #1877f2; }
  #nam-social-{{ section.id }} .nam-ig { background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); }
  #nam-social-{{ section.id }} .nam-tt { background: #111; }
  #nam-social-{{ section.id }} .nam-az { background: #232f3e; }
  #nam-social-{{ section.id }} .nam-az svg { fill: #ff9900; }
</style>

<div id="nam-social-{{ section.id }}">
  <div class="nam-inner">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}
    <div class="nam-buttons">
      {% if section.settings.facebook_url != blank %}
        <a class="nam-social-btn nam-fb" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
          Facebook
        </a>
      {% endif %}
      {% if section.settings.instagram_url != blank %}
        <a class="nam-social-btn nam-ig" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85C2.42 3.92 3.94 2.38 7.15 2.27 8.42 2.21 8.8 2.2 12 2.2zm0 3.68a6.12 6.12 0 1 0 0 12.24 6.12 6.12 0 0 0 0-12.24zm0 2.2a3.92 3.92 0 1 1 0 7.84 3.92 3.92 0 0 1 0-7.84zm6.4-2.71a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
          Instagram
        </a>
      {% endif %}
      {% if section.settings.tiktok_url != blank %}
        <a class="nam-social-btn nam-tt" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-2.01-2.76V9.39a6.34 6.34 0 1 0 5.46 6.28V9.01a8.16 8.16 0 0 0 4.77 1.53V7.1a4.85 4.85 0 0 1-1-.41z"/></svg>
          TikTok
        </a>
      {% endif %}
      {% if section.settings.amazon_url != blank %}
        <a class="nam-social-btn nam-az" href="{{ section.settings.amazon_url }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.9 8.89l-1.05-4.37c-.22-.9-1-1.52-1.91-1.52H5.05c-.9 0-1.69.63-1.9 1.52L2.1 8.89c-.24 1.02-.02 2.06.62 2.88.08.11.19.19.28.29V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6.94c.09-.09.2-.18.28-.28.64-.82.87-1.87.62-2.89zm-2.99-3.9l1.05 4.37c.1.42.01.84-.25 1.17-.14.18-.44.47-.94.47-.61 0-1.14-.49-1.21-1.14L16.98 5l1.93-.01zM13 5h1.96l.54 4.52c.05.39-.07.78-.33 1.07-.22.26-.54.41-.95.41-.67 0-1.22-.59-1.22-1.31V5zM8.49 9.52L9.04 5H11v4.69c0 .72-.55 1.31-1.29 1.31-.34 0-.65-.15-.89-.41-.25-.29-.37-.68-.33-1.07zm-4.45-.16L5.05 5h1.97l-.58 4.86c-.08.65-.6 1.14-1.21 1.14-.49 0-.8-.29-.93-.47-.27-.32-.36-.75-.26-1.17zM5 19v-6.03c.08.01.15.03.23.03.87 0 1.66-.36 2.24-.95.6.6 1.4.95 2.31.95.87 0 1.65-.36 2.23-.93.59.57 1.39.93 2.29.93.84 0 1.64-.35 2.24-.95.58.59 1.37.95 2.24.95.08 0 .15-.02.23-.03V19H5z"/></svg>
          Amazon Storefront
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NAM Follow Us",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the daily glow-ups 🐾" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Before-and-afters, fresh cuts, and very good dogs — every week." },
    { "type": "text", "id": "facebook_url", "label": "Facebook link", "default": "https://www.facebook.com/werenutsaboutmutts", "info": "Leave blank to hide the button." },
    { "type": "text", "id": "instagram_url", "label": "Instagram link", "default": "https://www.instagram.com/werenutsaboutmutts", "info": "Leave blank to hide the button." },
    { "type": "text", "id": "tiktok_url", "label": "TikTok link", "default": "https://www.tiktok.com/@werenutsaboutmutts", "info": "Leave blank to hide the button." },
    { "type": "text", "id": "amazon_url", "label": "Amazon storefront link", "default": "https://www.amazon.com/werenutsaboutmutts", "info": "Leave blank to hide the button." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FDF9F3" }
  ],
  "presets": [{ "name": "NAM Follow Us" }]
}
{% endschema %}
