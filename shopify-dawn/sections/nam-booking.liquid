{% comment %}
  Nuts About Mutts — Appointment Request (for the Dawn theme)
  A 4-step wizard: dog size → service → add-ons → contact details.
  Built on Shopify's contact form, so every request is emailed to your
  store's sender email — no extra apps needed. Edit services, prices,
  and add-ons in the theme editor.
{% endcomment %}

<style>
  #nam-book-{{ section.id }} { --nam-teal: {{ section.settings.accent_color }}; --nam-teal-dark: #15594f; --nam-teal-soft: #e3f2ef; --nam-coral: {{ section.settings.button_color }}; --nam-cream: #fdf9f3; --nam-sand: #f4ede2; --nam-ink: #2b2620; --nam-ink-soft: #6f675d; --nam-line: #e7dfd2; padding: 56px 20px; background: var(--nam-sand); color: var(--nam-ink); }
  #nam-book-{{ section.id }} .nam-inner { max-width: 780px; margin: 0 auto; }
  #nam-book-{{ section.id }} .nam-eyebrow { display: block; font-size: 13px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--nam-coral); margin-bottom: 8px; }
  #nam-book-{{ section.id }} h2 { font-size: clamp(28px, 4vw, 40px); margin: 0 0 24px; line-height: 1.15; }
  #nam-book-{{ section.id }} .nam-dots { display: flex; align-items: center; margin: 0 0 34px; }
  #nam-book-{{ section.id }} .nam-dot-wrap { display: flex; align-items: center; flex: 1; position: relative; }
  #nam-book-{{ section.id }} .nam-dot-wrap:last-child { flex: 0; }
  #nam-book-{{ section.id }} .nam-dot { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--nam-line); background: #fff; color: var(--nam-ink-soft); font-weight: 700; font-size: 15px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .2s; }
  #nam-book-{{ section.id }} .nam-dot.current { border-color: var(--nam-coral); color: var(--nam-coral); box-shadow: 0 0 0 5px rgba(244,132,95,.2); }
  #nam-book-{{ section.id }} .nam-dot.done { background: var(--nam-teal); border-color: var(--nam-teal); color: #fff; }
  #nam-book-{{ section.id }} .nam-dot-label { position: absolute; top: 44px; left: 20px; transform: translateX(-50%); font-size: 12px; font-weight: 700; color: #b6ad9f; white-space: nowrap; }
  #nam-book-{{ section.id }} .nam-dot-label.on { color: var(--nam-teal-dark); }
  #nam-book-{{ section.id }} .nam-dot-line { flex: 1; height: 2px; background: var(--nam-line); margin: 0 8px; }
  #nam-book-{{ section.id }} .nam-dot-line.done { background: var(--nam-teal); }
  #nam-book-{{ section.id }} .nam-card { background: #fff; border: 1px solid var(--nam-line); border-radius: 20px; padding: 30px 26px; box-shadow: 0 4px 24px rgba(43,38,32,.08); }
  #nam-book-{{ section.id }} .nam-step { display: none; }
  #nam-book-{{ section.id }} .nam-step.active { display: block; }
  #nam-book-{{ section.id }} .nam-q { font-size: 20px; margin: 0 0 20px; }
  #nam-book-{{ section.id }} .nam-q small { font-size: 14px; color: var(--nam-ink-soft); font-weight: 500; }
  #nam-book-{{ section.id }} .nam-choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  #nam-book-{{ section.id }} .nam-choice { position: relative; }
  #nam-book-{{ section.id }} .nam-choice input { position: absolute; opacity: 0; pointer-events: none; }
  #nam-book-{{ section.id }} .nam-choice label { display: flex; flex-direction: column; align-items: center; gap: 3px; text-align: center; background: var(--nam-cream); border: 2px solid var(--nam-line); border-radius: 16px; padding: 18px 12px; cursor: pointer; transition: border-color .15s, background .15s; }
  #nam-book-{{ section.id }} .nam-choice input:checked + label { border-color: var(--nam-teal); background: var(--nam-teal-soft); box-shadow: 0 0 0 4px var(--nam-teal-soft); }
  #nam-book-{{ section.id }} .nam-choice-icon { font-size: 32px; }
  #nam-book-{{ section.id }} .nam-choice strong { font-size: 15px; }
  #nam-book-{{ section.id }} .nam-choice-sub { font-size: 12px; color: var(--nam-ink-soft); }
  #nam-book-{{ section.id }} .nam-choice-price { margin-top: 4px; font-weight: 800; font-size: 17px; color: var(--nam-teal-dark); }
  #nam-book-{{ section.id }} .nam-addon-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  #nam-book-{{ section.id }} .nam-addon-grid label { display: flex; justify-content: space-between; align-items: center; gap: 8px; background: var(--nam-cream); border: 2px solid var(--nam-line); border-radius: 12px; padding: 13px 16px; cursor: pointer; font-size: 14px; }
  #nam-book-{{ section.id }} .nam-addon-grid input { position: absolute; opacity: 0; pointer-events: none; }
  #nam-book-{{ section.id }} .nam-addon-grid input:checked + label { border-color: var(--nam-teal); background: var(--nam-teal-soft); }
  #nam-book-{{ section.id }} .nam-addon-price { font-weight: 700; color: var(--nam-ink-soft); white-space: nowrap; }
  #nam-book-{{ section.id }} .nam-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  #nam-book-{{ section.id }} .nam-field { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: var(--nam-teal-dark); }
  #nam-book-{{ section.id }} .nam-field-full { grid-column: 1 / -1; }
  #nam-book-{{ section.id }} .nam-field input, #nam-book-{{ section.id }} .nam-field select, #nam-book-{{ section.id }} .nam-field textarea { font-size: 15px; padding: 12px 14px; border: 1.5px solid var(--nam-line); border-radius: 12px; background: var(--nam-cream); color: var(--nam-ink); width: 100%; box-sizing: border-box; }
  #nam-book-{{ section.id }} .nam-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; gap: 12px; flex-wrap: wrap; }
  #nam-book-{{ section.id }} .nam-back { background: none; border: none; cursor: pointer; font-weight: 700; font-size: 14px; color: var(--nam-ink-soft); padding: 8px 0; }
  #nam-book-{{ section.id }} .nam-btn { background: var(--nam-coral); color: #fff; border: none; border-radius: 999px; padding: 14px 30px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 6px 20px rgba(244,132,95,.4); }
  #nam-book-{{ section.id }} .nam-btn:disabled { opacity: .4; cursor: not-allowed; box-shadow: none; }
  #nam-book-{{ section.id }} .nam-summary { margin-top: 18px; background: #fff; border: 1px dashed #cfc6b6; border-radius: 14px; padding: 14px 20px; display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 14px; color: var(--nam-ink-soft); }
  #nam-book-{{ section.id }} .nam-summary strong { color: var(--nam-teal-dark); }
  #nam-book-{{ section.id }} .nam-success { text-align: center; padding: 30px 10px; }
  #nam-book-{{ section.id }} .nam-success-icon { font-size: 60px; }
  #nam-book-{{ section.id }} .nam-errors { background: #fee2e2; border: 1px solid #ef4444; border-radius: 12px; padding: 12px 18px; margin-bottom: 18px; color: #991b1b; font-size: 14px; }
  #nam-book-{{ section.id }} .nam-cat-note { margin: 18px 0 0; text-align: center; font-size: 14px; color: var(--nam-ink-soft); }
  @media (max-width: 749px) { #nam-book-{{ section.id }} .nam-addon-grid, #nam-book-{{ section.id }} .nam-fields { grid-template-columns: 1fr; } }
</style>

<div id="nam-book-{{ section.id }}">
  <div class="nam-inner">
    {% if section.settings.eyebrow != blank %}<span class="nam-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>

    {% form 'contact', id: 'nam-form' %}
      {% if form.posted_successfully %}
        <div class="nam-card nam-success">
          <div class="nam-success-icon">🎉</div>
          <h3>{{ section.settings.success_heading }}</h3>
          <p>{{ section.settings.success_text }}</p>
        </div>
      {% else %}
        {% if form.errors %}
          <div class="nam-errors">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div class="nam-dots" aria-hidden="true">
          <div class="nam-dot-wrap"><div class="nam-dot current" data-dot="1">1</div><span class="nam-dot-label on">Size</span><div class="nam-dot-line" data-line="1"></div></div>
          <div class="nam-dot-wrap"><div class="nam-dot" data-dot="2">2</div><span class="nam-dot-label">Service</span><div class="nam-dot-line" data-line="2"></div></div>
          <div class="nam-dot-wrap"><div class="nam-dot" data-dot="3">3</div><span class="nam-dot-label">Extras</span><div class="nam-dot-line" data-line="3"></div></div>
          <div class="nam-dot-wrap"><div class="nam-dot" data-dot="4">4</div><span class="nam-dot-label">Your Info</span></div>
        </div>

        <div class="nam-card">
          {%- comment -%} STEP 1 — dog size {%- endcomment -%}
          <div class="nam-step active" data-step="1">
            <h3 class="nam-q">How big is your pup?</h3>
            <div class="nam-choices">
              {% assign sizes = 'small,medium,large,xl' | split: ',' %}
              {% for size in sizes %}
                {% assign label_key = 'label_' | append: size %}
                {% assign range_key = 'range_' | append: size %}
                {% assign icon_key = 'icon_' | append: size %}
                <div class="nam-choice">
                  <input type="radio" id="nam-size-{{ size }}-{{ section.id }}" name="contact[Dog Size]" value="{{ section.settings[label_key] }} ({{ section.settings[range_key] }})" data-size="{{ size }}">
                  <label for="nam-size-{{ size }}-{{ section.id }}">
                    <span class="nam-choice-icon">{{ section.settings[icon_key] }}</span>
                    <strong>{{ section.settings[label_key] }}</strong>
                    <span class="nam-choice-sub">{{ section.settings[range_key] }}</span>
                  </label>
                </div>
              {% endfor %}
            </div>
            <div class="nam-nav">
              <span></span>
              <button type="button" class="nam-btn" data-next disabled>Next: Choose a Service →</button>
            </div>
          </div>

          {%- comment -%} STEP 2 — service {%- endcomment -%}
          <div class="nam-step" data-step="2">
            <h3 class="nam-q">What does your pup need?</h3>
            <div class="nam-choices">
              {% for block in section.blocks %}
                {% if block.type == 'service' %}
                  <div class="nam-choice" {{ block.shopify_attributes }}>
                    <input type="radio" id="nam-svc-{{ block.id }}" name="contact[Service]" value="{{ block.settings.title }}"
                      data-small="{{ block.settings.price_small }}" data-medium="{{ block.settings.price_medium }}" data-large="{{ block.settings.price_large }}" data-xl="{{ block.settings.price_xl }}">
                    <label for="nam-svc-{{ block.id }}">
                      <span class="nam-choice-icon">{{ block.settings.icon }}</span>
                      <strong>{{ block.settings.title }}</strong>
                      {% if block.settings.subtitle != blank %}<span class="nam-choice-sub">{{ block.settings.subtitle }}</span>{% endif %}
                      <span class="nam-choice-price" data-svc-price>—</span>
                    </label>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="nam-nav">
              <button type="button" class="nam-back" data-back>← Change size</button>
              <button type="button" class="nam-btn" data-next disabled>Next: Extras →</button>
            </div>
          </div>

          {%- comment -%} STEP 3 — add-ons {%- endcomment -%}
          <div class="nam-step" data-step="3">
            <h3 class="nam-q">Any pawsome extras? <small>(optional)</small></h3>
            <div class="nam-addon-grid">
              {% for block in section.blocks %}
                {% if block.type == 'addon' %}
                  <div style="position:relative" {{ block.shopify_attributes }}>
                    <input type="checkbox" id="nam-addon-{{ block.id }}" data-addon="{{ block.settings.name | strip_html }}" data-price="{{ block.settings.price }}">
                    <label for="nam-addon-{{ block.id }}">
                      <span>{{ block.settings.name }}</span>
                      <span class="nam-addon-price">+${{ block.settings.price }}</span>
                    </label>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <input type="hidden" name="contact[Add-ons]" value="None" data-addons-field>
            <div class="nam-nav">
              <button type="button" class="nam-back" data-back>← Change service</button>
              <button type="button" class="nam-btn" data-next>Continue →</button>
            </div>
          </div>

          {%- comment -%} STEP 4 — contact details {%- endcomment -%}
          <div class="nam-step" data-step="4">
            <h3 class="nam-q">Almost done — who's coming in?</h3>
            <div class="nam-fields">
              <div class="nam-field"><label for="nam-name-{{ section.id }}">Your name *</label><input id="nam-name-{{ section.id }}" type="text" name="contact[Name]" placeholder="e.g. Sarah Johnson" required></div>
              <div class="nam-field"><label for="nam-pet-{{ section.id }}">Pup's name *</label><input id="nam-pet-{{ section.id }}" type="text" name="contact[Pup's Name]" placeholder="e.g. Bella" required></div>
              <div class="nam-field"><label for="nam-email-{{ section.id }}">Email *</label><input id="nam-email-{{ section.id }}" type="email" name="contact[email]" placeholder="you@example.com" required></div>
              <div class="nam-field"><label for="nam-phone-{{ section.id }}">Phone number *</label><input id="nam-phone-{{ section.id }}" type="tel" name="contact[Phone]" placeholder="e.g. 555-867-5309" required></div>
              <div class="nam-field">
                <label for="nam-day-{{ section.id }}">Preferred day *</label>
                <select id="nam-day-{{ section.id }}" name="contact[Preferred Day]" required>
                  <option value="">Choose a day...</option>
                  {% assign days = section.settings.days | split: ',' %}
                  {% for day in days %}<option>{{ day | strip }}</option>{% endfor %}
                </select>
              </div>
              <div class="nam-field">
                <label for="nam-time-{{ section.id }}">Preferred time *</label>
                <select id="nam-time-{{ section.id }}" name="contact[Preferred Time]" required>
                  <option value="">Choose a time...</option>
                  {% assign times = section.settings.times | split: ',' %}
                  {% for time in times %}<option>{{ time | strip }}</option>{% endfor %}
                </select>
              </div>
              <div class="nam-field nam-field-full"><label for="nam-notes-{{ section.id }}">Anything we should know? (optional)</label><textarea id="nam-notes-{{ section.id }}" name="contact[Notes]" rows="3" placeholder="Nervous pup, matted coat, favorite treat..."></textarea></div>
            </div>
            <input type="hidden" name="contact[Estimated Total]" value="" data-total-field>
            <div class="nam-nav">
              <button type="button" class="nam-back" data-back>← Back</button>
              <button type="submit" class="nam-btn">Request Appointment 🐾</button>
            </div>
          </div>
        </div>

        {% if section.settings.cat_note != blank %}<p class="nam-cat-note">{{ section.settings.cat_note }}</p>{% endif %}

        <div class="nam-summary" hidden data-summary>
          <span data-summary-text></span>
          <span>Est. total: <strong data-summary-total></strong></span>
        </div>
      {% endif %}
    {% endform %}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('nam-book-{{ section.id }}');
    if (!root || !root.querySelector('.nam-step')) return;

    var step = 1;
    var sizeName = null;

    function selectedSize() {
      var r = root.querySelector('input[name="contact[Dog Size]"]:checked');
      return r ? r.dataset.size : null;
    }
    function selectedService() {
      return root.querySelector('input[name="contact[Service]"]:checked');
    }
    function addonsChecked() {
      return Array.prototype.slice.call(root.querySelectorAll('input[data-addon]:checked'));
    }
    function total() {
      var svc = selectedService();
      var size = selectedSize();
      var sum = svc && size ? parseInt(svc.dataset[size], 10) || 0 : 0;
      addonsChecked().forEach(function (a) { sum += parseInt(a.dataset.price, 10) || 0; });
      return sum;
    }
    function refresh() {
      root.querySelectorAll('.nam-step').forEach(function (el) {
        el.classList.toggle('active', parseInt(el.dataset.step, 10) === step);
      });
      root.querySelectorAll('.nam-dot').forEach(function (dot) {
        var n = parseInt(dot.dataset.dot, 10);
        dot.classList.toggle('current', n === step);
        dot.classList.toggle('done', n < step);
        dot.textContent = n < step ? '✓' : n;
      });
      root.querySelectorAll('.nam-dot-line').forEach(function (line) {
        line.classList.toggle('done', parseInt(line.dataset.line, 10) < step);
      });
      root.querySelectorAll('.nam-dot-label').forEach(function (lbl, i) {
        lbl.classList.toggle('on', i + 1 <= step);
      });
      var size = selectedSize();
      if (size) {
        root.querySelectorAll('input[name="contact[Service]"]').forEach(function (r) {
          r.parentElement.querySelector('[data-svc-price]').textContent = '$' + r.dataset[size];
        });
      }
      var step1Next = root.querySelector('[data-step="1"] [data-next]');
      var step2Next = root.querySelector('[data-step="2"] [data-next]');
      if (step1Next) step1Next.disabled = !size;
      if (step2Next) step2Next.disabled = !selectedService();

      var names = addonsChecked().map(function (a) { return a.dataset.addon + ' (+$' + a.dataset.price + ')'; });
      root.querySelector('[data-addons-field]').value = names.length ? names.join(', ') : 'None';
      root.querySelector('[data-total-field]').value = '$' + total();

      var summary = root.querySelector('[data-summary]');
      var svc = selectedService();
      if (svc || size) {
        summary.hidden = false;
        var sizeInput = root.querySelector('input[name="contact[Dog Size]"]:checked');
        var parts = [];
        if (sizeInput) parts.push(sizeInput.value.split(' (')[0]);
        if (svc) parts.push(svc.value);
        if (names.length) parts.push(names.length + ' extra' + (names.length > 1 ? 's' : ''));
        summary.querySelector('[data-summary-text]').textContent = parts.join(' · ');
        summary.querySelector('[data-summary-total]').textContent = '$' + total();
      } else {
        summary.hidden = true;
      }
    }

    root.querySelectorAll('[data-next]').forEach(function (btn) {
      btn.addEventListener('click', function () { if (step < 4) { step += 1; refresh(); } });
    });
    root.querySelectorAll('[data-back]').forEach(function (btn) {
      btn.addEventListener('click', function () { if (step > 1) { step -= 1; refresh(); } });
    });
    root.querySelectorAll('input[name="contact[Dog Size]"]').forEach(function (r) {
      r.addEventListener('change', function () { step = 2; refresh(); });
    });
    root.querySelectorAll('input[name="contact[Service]"]').forEach(function (r) {
      r.addEventListener('change', function () { step = 3; refresh(); });
    });
    root.querySelectorAll('input[data-addon]').forEach(function (c) {
      c.addEventListener('change', refresh);
    });
    refresh();
  })();
</script>

{% schema %}
{
  "name": "NAM Appointment Form",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Requests are sent to your store's sender email (Settings → Notifications in your Shopify admin), just like the contact form." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Book an appointment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's get your pup pampered" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Request sent — happy dance!" },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "Thanks! We've got your request and we'll call or text you shortly to confirm your pup's appointment time. 🐾" },
    { "type": "text", "id": "days", "label": "Bookable days (comma separated)", "default": "Monday, Tuesday, Wednesday, Thursday, Friday, Saturday" },
    { "type": "text", "id": "times", "label": "Time windows (comma separated)", "default": "Morning (8–11 AM), Midday (11 AM–2 PM), Afternoon (2–5 PM)" },
    { "type": "text", "id": "cat_note", "label": "Cat note (shown under the form)", "default": "🐱 Booking for a cat? Cat appointments are scheduled by phone — give us a call." },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#1F7A70" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#F4845F" },
    { "type": "header", "content": "Dog sizes" },
    { "type": "text", "id": "icon_small", "label": "Small icon", "default": "🐕‍🦺" },
    { "type": "text", "id": "label_small", "label": "Small label", "default": "Small" },
    { "type": "text", "id": "range_small", "label": "Small weight range", "default": "Under 20 lbs" },
    { "type": "text", "id": "icon_medium", "label": "Medium icon", "default": "🐕" },
    { "type": "text", "id": "label_medium", "label": "Medium label", "default": "Medium" },
    { "type": "text", "id": "range_medium", "label": "Medium weight range", "default": "20 – 50 lbs" },
    { "type": "text", "id": "icon_large", "label": "Large icon", "default": "🦮" },
    { "type": "text", "id": "label_large", "label": "Large label", "default": "Large" },
    { "type": "text", "id": "range_large", "label": "Large weight range", "default": "50 – 90 lbs" },
    { "type": "text", "id": "icon_xl", "label": "Extra Large icon", "default": "🐩" },
    { "type": "text", "id": "label_xl", "label": "Extra Large label", "default": "Extra Large" },
    { "type": "text", "id": "range_xl", "label": "Extra Large weight range", "default": "Over 90 lbs" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✂️" },
        { "type": "text", "id": "title", "label": "Service name", "default": "Full Groom" },
        { "type": "text", "id": "subtitle", "label": "Short subtitle" },
        { "type": "number", "id": "price_small", "label": "Price — Small ($)", "default": 85 },
        { "type": "number", "id": "price_medium", "label": "Price — Medium ($)", "default": 125 },
        { "type": "number", "id": "price_large", "label": "Price — Large ($)", "default": 175 },
        { "type": "number", "id": "price_xl", "label": "Price — Extra Large ($)", "default": 240 }
      ]
    },
    {
      "type": "addon",
      "name": "Add-on",
      "settings": [
        { "type": "text", "id": "name", "label": "Add-on name", "default": "💅 Nail Grind" },
        { "type": "number", "id": "price", "label": "Price ($)", "default": 12 }
      ]
    }
  ],
  "presets": [
    {
      "name": "NAM Appointment Form",
      "blocks": [
        { "type": "service", "settings": { "icon": "✂️", "title": "Full Body Cut", "subtitle": "The Full Mutt Makeover", "price_small": 85, "price_medium": 125, "price_large": 175, "price_xl": 240 } },
